# Forge configuration — copy this file to ".env" and fill in your values.
# ".env" is gitignored, so your real key is never committed.

# ---- Provider: "openai" or "ollama" ----
# If OPENAI_API_KEY is set, Forge uses OpenAI automatically.
FORGE_PROVIDER=openai

# ---- OpenAI ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-with-your-real-key
# Model: gpt-4o-mini (cheap, fast) or gpt-4o (stronger). Default: gpt-4o-mini
FORGE_MODEL=gpt-4o-mini

# ---- Local Ollama (only used when FORGE_PROVIDER=ollama) ----
# OLLAMA_HOST=http://localhost:11434
# FORGE_MODEL=qwen2.5-coder:7b
